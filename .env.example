# ==============================================================================
# CAPITAL CONTROL - AMBIENTE DE PRODUÇÃO E COOLIFY
# ==============================================================================

# 1. Configurações do Supabase (Instância Coolify ou Supabase Cloud)
# URL acessível publicamente ou via rede interna do Coolify (ex: http://supabase-kong:8000)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Chave anónima pública (utilizada no frontend Next.js)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave Service Role secreta (utilizada exclusivamente no backend e no Bot WhatsApp)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# Conexão direta ao banco PostgreSQL para execução de migrações
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# 2. Configurações da Aplicação Web
# URL base pública da aplicação para geração dos links públicos de comprovante (/recibo/[hash])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Configurações de Segurança do Bot de WhatsApp (Baileys WebSocket)
# Lista de telefones de administradores autorizados no formato E.164 sem '+' (separados por vírgula)
# Apenas números listados aqui conseguirão executar comandos de caixa, despesa, baixa e consulta.
WHATSAPP_ADMIN_WHITELIST=5511999999999,5511988887777

# UUID do operador principal no Supabase associado aos lançamentos efetuados pelo WhatsApp
DEFAULT_OPERATOR_ID=00000000-0000-0000-0000-000000000001

# Caminho para armazenamento persistente da sessão e QR Code do WhatsApp
WHATSAPP_AUTH_FOLDER=./auth_info_baileys

# Nível de log do serviço (fatal | error | warn | info | debug | trace)
LOG_LEVEL=warn
